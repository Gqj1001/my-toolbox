# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 本地测试账号留痕（含测试用邮箱与密码，不得提交）
.test-users.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地备份（改造前的原版文件）
/.backup/

# CSV 写回候选表时的本地快照（含原始数据，属运行时产物，不入库）
/docs/csv-apply-backup-*.json

# dev 服务器日志（本地排查用）
/.dev-server.log*

# 历史遗留回归脚本，暂不维护
# （problem1/problem2 记录的是第 7 步 AI 关键词导入**之前**的数据规模：
#   教材 41 本 / 章节 272 / 关键词 658；导入后已是 219 / 4273 / 9016。
#   断言本身已过期，不再作为通过标准。保留仅供参考。）
/tests/*.legacy.mjs

# 其他学科素材暂存区（老师提供的原始报告，含真实学校/学生信息，不得入库）
# 规则先全忽略，再放行目录结构本身与说明文件，这样「空结构」能进仓库、
# 「老师放进去的原始文件」永远不会被 git add -A 顺手带走。
/other-subjects/**
!/other-subjects/README.md
!/other-subjects/*/
!/other-subjects/*/README.md
!/other-subjects/*/*/
!/other-subjects/*/*/README.md

